{
  "name": "homeport",
  "version": "3.7.0",
  "description": "Self-hosted deploy platform for a Mac mini: git push deploys with rollback, pm2, Caddy, Cloudflare Tunnel, Prometheus and Grafana.",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "reset-password": "node dist/server/reset-auth.js",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "diagrams": "tsx scripts/diagrams.ts",
    "check:monitoring": "tsx scripts/check-monitoring.ts .tmp/monitoring",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/http-proxy": "^11.6.5",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DarmawanWeb/homeport-management.git"
  },
  "homepage": "https://darmawanweb.github.io/homeport-management/",
  "keywords": [
    "paas",
    "self-hosted",
    "deploy",
    "pm2",
    "caddy",
    "cloudflare-tunnel",
    "prometheus",
    "grafana",
    "mac-mini"
  ]
}
